{%- comment -%}
  Vékony vonalas ikonok.
  Használat: {% render 'icon', icon: 'cart' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'menu' -%}
    <svg class="icon icon--menu" width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M0 1h20M0 7h20M0 13h20"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon--close" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M1 1l14 14M15 1L1 15"/></svg>
  {%- when 'search' -%}
    <svg class="icon icon--search" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="7.5" cy="7.5" r="6"/><path d="M12 12l5 5"/></svg>
  {%- when 'account' -%}
    <svg class="icon icon--account" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="9" cy="5.5" r="4"/><path d="M1.5 17c1-4 4-5.5 7.5-5.5s6.5 1.5 7.5 5.5"/></svg>
  {%- when 'cart' -%}
    <svg class="icon icon--cart" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M2.5 5.5h13l-1 11.5h-11z"/><path d="M6 7V4.5a3 3 0 016 0V7"/></svg>
  {%- when 'arrow' -%}
    <svg class="icon icon--arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M0 5h13M9 1l4 4-4 4"/></svg>
  {%- when 'chevron' -%}
    <svg class="icon icon--chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4"/></svg>
  {%- when 'plus' -%}
    <svg class="icon icon--plus" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M6 0v12M0 6h12"/></svg>
  {%- when 'minus' -%}
    <svg class="icon icon--minus" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M0 6h12"/></svg>
  {%- when 'truck' -%}
    <svg class="icon icon--truck" width="26" height="20" viewBox="0 0 26 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M1 3h15v11H1zM16 7h5l4 4v3h-9"/><circle cx="6" cy="16" r="2"/><circle cx="20" cy="16" r="2"/></svg>
  {%- when 'shield' -%}
    <svg class="icon icon--shield" width="20" height="22" viewBox="0 0 20 22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M10 1l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V4z"/><path d="M6.5 11l2.5 2.5 4.5-5"/></svg>
  {%- when 'return' -%}
    <svg class="icon icon--return" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M19 8A8.5 8.5 0 003.5 6M3 14a8.5 8.5 0 0015.5 2"/><path d="M3 2v4.5h4.5M19 20v-4.5h-4.5"/></svg>
  {%- when 'headset' -%}
    <svg class="icon icon--headset" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M3 13v-2a8 8 0 0116 0v2"/><rect x="1.5" y="12" width="4" height="6" rx="1"/><rect x="16.5" y="12" width="4" height="6" rx="1"/><path d="M18.5 18c0 2-2 3-5 3"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon icon--instagram" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><rect x="1" y="1" width="16" height="16" rx="4.5"/><circle cx="9" cy="9" r="3.6"/><circle cx="13.5" cy="4.5" r="0.6" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon icon--tiktok" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M10 1v11a3.5 3.5 0 11-3.5-3.5"/><path d="M10 1c.5 2.5 2.5 4.3 5 4.5"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon icon--facebook" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M11.5 1.5H10a3 3 0 00-3 3V7H5v3h2v7h3v-7h2.5l.5-3h-3V5a1 1 0 011-1h1.5z"/></svg>
{%- endcase -%}
