{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
-%}
{%- if threshold > 0 -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
  -%}
  <div class="shipping-bar">
    {%- if remaining <= 0 -%}
      <span>{{ 'cart.free_shipping_reached' | t }}</span>
    {%- else -%}
      {%- assign remaining_money = remaining | money -%}
      <span>{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}</span>
    {%- endif -%}
    <div class="shipping-bar__track" aria-hidden="true"><div class="shipping-bar__fill" style="width: {{ percent }}%;"></div></div>
  </div>
{%- endif -%}
