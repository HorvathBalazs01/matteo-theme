[
  {
    "name": "theme_info",
    "theme_name": "Matteo",
    "theme_version": "1.0.0",
    "theme_author": "Matteo",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Logó",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logó",
        "info": "Fehér, átlátszó hátterű PNG vagy SVG. Ha üres, a témába épített logó jelenik meg."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logó szélessége a fejlécben",
        "min": 80,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Négyzetes kép, legalább 64 × 64 px."
      }
    ]
  },
  {
    "name": "Színek",
    "settings": [
      { "type": "color", "id": "color_bg", "label": "Háttér", "default": "#0A0A0A" },
      { "type": "color", "id": "color_bg_deep", "label": "Mélyfekete (footer)", "default": "#070707" },
      { "type": "color", "id": "color_surface", "label": "Felület (sávok, panelek)", "default": "#121212" },
      { "type": "color", "id": "color_line", "label": "Vonalak", "default": "#1E1E1E" },
      { "type": "color", "id": "color_line_strong", "label": "Erősebb vonalak, keretek", "default": "#4A4A4A" },
      { "type": "color", "id": "color_text", "label": "Szöveg", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text_soft", "label": "Hosszabb szöveg", "default": "#B3B3B3" },
      { "type": "color", "id": "color_muted", "label": "Másodlagos szöveg", "default": "#8A8A8A" },
      { "type": "color", "id": "color_placeholder", "label": "Képek háttere", "default": "#1A1A1A" }
    ]
  },
  {
    "name": "Elrendezés",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Maximális oldalszélesség",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1440
      }
    ]
  },
  {
    "name": "Kosár",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Kosár típusa",
        "options": [
          { "value": "drawer", "label": "Oldalt kinyíló panel" },
          { "value": "page", "label": "Külön kosár oldal" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Ingyenes szállítás értékhatára (Ft)",
        "info": "0 = nem jelenik meg a folyamatjelző. A tényleges szállítási díjat a Beállítások → Szállítás menüben állítsd be.",
        "default": 30000
      }
    ]
  },
  {
    "name": "Közösségi média",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram link", "placeholder": "https://instagram.com/matteo" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok link", "placeholder": "https://tiktok.com/@matteo" },
      { "type": "text", "id": "social_facebook", "label": "Facebook link", "placeholder": "https://facebook.com/matteo" }
    ]
  }
]
