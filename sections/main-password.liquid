<div class="password">
  <div class="password__logo">{% render 'logo', eager: true %}</div>
  <h1 class="display" style="font-size: 18px;">{{ section.settings.heading | default: shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <p style="color: var(--color-text-soft); max-width: 480px;">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'password__form' -%}
    <label for="password-input" class="visually-hidden">{{ 'password.label' | t }}</label>
    <input type="password" id="password-input" name="password" class="field" placeholder="{{ 'password.label' | t }}" autocomplete="current-password" required>
    <button type="submit" class="btn btn--solid">{{ 'password.submit' | t }}</button>
    {%- if form.errors -%}
      <p class="password__error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
  {%- endform -%}

  <p class="password__admin">{{ 'password.admin' | t }} <a href="/admin" rel="nofollow">{{ 'password.admin_link' | t }}</a></p>
</div>

{% schema %}
{
  "name": "Jelszó oldal",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Cím", "default": "Hamarosan nyitunk" }
  ]
}
{% endschema %}
