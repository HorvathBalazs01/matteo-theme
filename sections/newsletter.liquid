{%- assign form_id = 'newsletter-' | append: section.id -%}
<section class="section page-width" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="newsletter">
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter__heading display">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="newsletter__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__row">
        <label for="{{ form_id }}-email" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
        <input id="{{ form_id }}-email" type="email" name="contact[email]" class="field" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
        <button type="submit" class="btn btn--solid">{{ 'newsletter.subscribe' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__msg" role="status">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="newsletter__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Hírlevél",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Cím", "default": "Csatlakozz a Matteo közösséghez" },
    { "type": "richtext", "id": "text", "label": "Szöveg", "default": "<p>Iratkozz fel, és elsőként értesülsz az új drop-okról.</p>" },
    { "type": "range", "id": "padding_top", "label": "Felső térköz", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Alsó térköz", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Hírlevél" }]
}
{% endschema %}
