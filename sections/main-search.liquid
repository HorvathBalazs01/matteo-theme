<div class="search-page page-width">
  <h1 class="page__title display">{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <label for="search-page-input" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
    <input type="search" id="search-page-input" name="q" value="{{ search.terms | escape }}" class="field" placeholder="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="btn btn--solid">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="search-page__summary">
        {%- if search.results_count > 0 -%}
          {{ 'search.results' | t: count: search.results_count, terms: search.terms }}
        {%- else -%}
          {{ 'search.no_results' | t: terms: search.terms }}
        {%- endif -%}
      </p>

      {%- if search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- for item in search.results -%}
          {%- if item.object_type != 'product' -%}
            <a href="{{ item.url }}" class="result-row">
              <span class="label">{{ item.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Keresési találatok",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
