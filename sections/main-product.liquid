{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign size_chart_shown = false
  assign option_names = product.options | join: ',' | downcase
-%}

<section class="product page-width" data-product data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span aria-hidden="true">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="product__grid">
    <div class="product__gallery" data-gallery>
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          {%- liquid
            assign is_large = false
            if forloop.first and section.settings.large_first
              assign is_large = true
            endif
            assign loading = 'lazy'
            if forloop.index <= 2
              assign loading = 'eager'
            endif
            assign media_alt = media.alt | default: product.title | escape
          -%}
          <div class="product__media{% if is_large %} product__media--large{% endif %}" data-media-id="{{ media.id }}">
            {%- if media.media_type == 'image' -%}
              {{ media | image_url: width: 1800 | image_tag: loading: loading, widths: '500,750,1000,1400,1800', sizes: '(min-width: 990px) 33vw, 86vw', alt: media_alt }}
            {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
              {{ media | media_tag: image_size: '1400x', autoplay: true, loop: true, muted: true, controls: false }}
            {%- else -%}
              {{ media | media_tag }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="product__media product__media--large">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        <div class="product__media">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        <div class="product__media">{{ 'product-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    <div class="product__info" data-product-info>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {%- if block.settings.eyebrow != blank -%}
                <span class="product__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- elsif product.type != blank -%}
                <span class="product__eyebrow">{{ product.type }}</span>
              {%- endif -%}
              <h1 class="product__title display">{{ product.title }}</h1>
            </div>

          {%- when 'price' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              <div class="product__price" data-price data-dynamic="price">
                {% render 'price', product: product, use_variant: true %}
              </div>
              {%- if block.settings.show_tax_note -%}
                <span class="product__tax">{{ 'cart.taxes' | t }}</span>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- liquid
              assign size_chart_page = block.settings.size_chart_page
              if size_chart_page == blank
                assign size_chart_page = pages['merettablazat']
              endif
              assign size_chart_label = block.settings.size_chart_label
              if size_chart_label == blank
                assign size_chart_label = 'products.size_chart' | t
              endif
              assign size_chart_id = 'size-chart-' | append: section.id
              assign use_list = false
              if block.settings.picker_style == 'list'
                assign use_list = true
              endif
            -%}
            {%- capture size_chart_link -%}
              <a href="{{ size_chart_page.url }}" class="option__size-link" data-drawer-open="{{ size_chart_id }}" data-size-chart-url="{{ size_chart_page.url }}" aria-controls="{{ size_chart_id }}" aria-expanded="false" aria-haspopup="dialog">{{ size_chart_label }}</a>
            {%- endcapture -%}
            <div class="product__block product__variants"{% unless product.has_only_default_variant %} data-variant-picker{% endunless %} {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_index = forloop.index0
                    assign option_name = option.name | downcase
                    assign is_size_option = false
                    if option_name contains 'méret' or option_name contains 'meret' or option_name contains 'size'
                      assign is_size_option = true
                    endif
                    assign has_swatches = false
                    if option.values.first.swatch
                      assign has_swatches = true
                    endif
                  -%}
                  <fieldset class="option{% if use_list and has_swatches == false %} option--list{% endif %}" data-option-index="{{ option_index }}">
                    <legend class="option__legend">
                      <div>{{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span></div>
                      {%- if is_size_option and size_chart_page != blank and size_chart_shown == false -%}
                        {{ size_chart_link }}
                        {%- assign size_chart_shown = true -%}
                      {%- endif -%}
                    </legend>
                    <div class="option__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                        <div class="option__value{% if value.swatch %} option__value--swatch{% endif %}{% unless value.available %} is-unavailable{% endunless %}">
                          <input
                            type="radio"
                            id="{{ input_id }}"
                            name="{{ section.id }}-option-{{ option.position }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            data-option-value
                          >
                          <label for="{{ input_id }}" {% if value.swatch %}title="{{ value | escape }}"{% endif %}>
                            {%- if value.swatch -%}
                              {%- if value.swatch.image -%}
                                {%- assign swatch_bg = value.swatch.image | image_url: width: 60 -%}
                                <span class="swatch" style="background: url({{ swatch_bg }}) center / cover;"></span>
                              {%- else -%}
                                <span class="swatch" style="background: {{ value.swatch.color }};"></span>
                              {%- endif -%}
                              <span class="visually-hidden">{{ value }}</span>
                            {%- elsif use_list -%}
                              <span class="option__check" aria-hidden="true"></span>
                              <span class="option__name">{{ value }}</span>
                              <span class="option__status option__status--in">{{ 'products.in_stock' | t }}</span>
                              <span class="option__status option__status--out">{{ 'products.sold_out' | t }}</span>
                            {%- else -%}
                              {{ value }}
                            {%- endif -%}
                          </label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                {%- if size_chart_page != blank and size_chart_shown == false -%}
                  {%- comment -%} Nincs „Méret” nevű opció: a link a választók alá kerül {%- endcomment -%}
                  <div class="option__size-fallback">{{ size_chart_link }}</div>
                  {%- assign size_chart_shown = true -%}
                {%- endif -%}
              {%- endunless -%}

              {%- if block.settings.show_stock -%}
                {%- liquid
                  assign stock_low = false
                  if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock
                    assign stock_low = true
                  endif
                -%}
                <p class="product__stock" data-dynamic="stock">
                  {%- if current_variant.available == false -%}
                    <span class="stock stock--out">{{ 'products.sold_out' | t }}</span>
                  {%- elsif stock_low -%}
                    <span class="stock stock--low">{{ 'products.low_stock' | t: count: current_variant.inventory_quantity }}</span>
                  {%- else -%}
                    <span class="stock stock--in">{{ 'products.in_stock' | t }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}

              {%- unless product.has_only_default_variant -%}
                <script type="application/json" data-variants>
                  {{ product.variants | json }}
                </script>
              {%- endunless -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              {%- if block.settings.style == 'accordion' -%}
                <div class="accordion" {{ block.shopify_attributes }}>
                  <details {% if block.settings.open %}open{% endif %}>
                    <summary>{{ block.settings.heading }} {% render 'icon', icon: 'plus' %}{% render 'icon', icon: 'minus' %}</summary>
                    <div class="accordion__content rte">{{ product.description }}</div>
                  </details>
                </div>
              {%- else -%}
                <div class="product__block product__description" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="product__label">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  <div class="rte">{{ product.description }}</div>
                </div>
              {%- endif -%}
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product__form', novalidate: 'novalidate', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <div class="product__buttons" data-buy-buttons>
                  <button
                    type="submit"
                    name="add"
                    class="btn btn--solid btn--full"
                    data-add-button
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-label>
                      {%- if current_variant.available -%}
                        {{ 'products.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.pair_product != blank and block.settings.pair_product.id != product.id -%}
                    <a href="{{ block.settings.pair_product.url }}" class="btn btn--full">
                      {%- assign pair_label = block.settings.pair_label -%}
                      {%- if pair_label == blank -%}{%- assign pair_label = 'products.as_set' | t -%}{%- endif -%}
                      {{ pair_label }}: + {{ block.settings.pair_product.title }}
                    </a>
                  {%- endif -%}
                </div>
                <p class="product__error" role="alert" data-form-error></p>
              {%- endform -%}
            </div>

          {%- when 'perks' -%}
            {%- if block.settings.lines != blank -%}
              {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
              <ul class="perks" {{ block.shopify_attributes }}>
                {%- for line in lines -%}
                  {%- assign l = line | strip -%}
                  {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'details' -%}
            {%- comment -%}
              Termék részletei: a termékkategória adatai (Anyag, Szín, Nem, Ujjhossz…, a Shopify
              „shopify” névterű kategória-metamezői), cikkszám, kategória, típus, márka, súly,
              és legfeljebb 4 saját sor (a szerkesztőben metamezőhöz köthető).
            {%- endcomment -%}
            {%- capture details_rows -%}
              {%- if block.settings.show_category and product.category != blank -%}
                <div class="details__row"><dt>{{ 'products.category' | t }}</dt><dd>{{ product.category.name }}</dd></div>
              {%- endif -%}
              {%- if block.settings.show_type and product.type != blank -%}
                <div class="details__row"><dt>{{ 'products.type' | t }}</dt><dd>{{ product.type }}</dd></div>
              {%- endif -%}
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <div class="details__row"><dt>{{ 'products.vendor' | t }}</dt><dd>{{ product.vendor }}</dd></div>
              {%- endif -%}

              {%- if block.settings.show_category_metafields -%}
                {%- assign detail_keys = 'fabric,material,color-pattern,size,target-gender,age-group,fit,sleeve-length-type,neckline,top-length-type,pants-length-type,waist-rise,closure-type,clothing-features,activity,care-instructions' | split: ',' -%}
                {%- for key in detail_keys -%}
                  {%- liquid
                    assign skip = false
                    if key == 'size'
                      if option_names contains 'méret' or option_names contains 'meret' or option_names contains 'size'
                        assign skip = true
                      endif
                    elsif key == 'color-pattern'
                      if option_names contains 'szín' or option_names contains 'szin' or option_names contains 'color' or option_names contains 'colour'
                        assign skip = true
                      endif
                    endif
                    assign mf = product.metafields.shopify[key]
                  -%}
                  {%- if skip == false and mf != blank -%}
                    {%- assign label_key = 'products.details.' | append: key | replace: '-', '_' -%}
                    <div class="details__row">
                      <dt>{{ label_key | t }}</dt>
                      <dd>
                        {%- case mf.type -%}
                          {%- when 'list.metaobject_reference' -%}
                            {%- for item in mf.value -%}
                              {{- item.label.value | default: item.label -}}
                              {%- unless forloop.last %}, {% endunless -%}
                            {%- endfor -%}
                          {%- when 'metaobject_reference' -%}
                            {{- mf.value.label.value | default: mf.value.label -}}
                          {%- else -%}
                            {{- mf | metafield_text -}}
                        {%- endcase -%}
                      </dd>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {%- for i in (1..4) -%}
                {%- liquid
                  assign custom_label_key = 'label_' | append: i
                  assign custom_value_key = 'value_' | append: i
                  assign custom_label = block.settings[custom_label_key]
                  assign custom_value = block.settings[custom_value_key]
                -%}
                {%- if custom_label != blank and custom_value != blank -%}
                  <div class="details__row"><dt>{{ custom_label }}</dt><dd>{{ custom_value }}</dd></div>
                {%- endif -%}
              {%- endfor -%}

              {%- if block.settings.show_weight and current_variant.weight > 0 -%}
                <div class="details__row"><dt>{{ 'products.weight' | t }}</dt><dd>{{ current_variant.weight | weight_with_unit: current_variant.weight_unit }}</dd></div>
              {%- endif -%}

              {%- if block.settings.show_sku -%}
                {%- assign all_skus = product.variants | map: 'sku' | join: '' -%}
                {%- if all_skus != blank -%}
                  <div class="details__row" data-dynamic="sku">
                    {%- if current_variant.sku != blank -%}<dt>{{ 'products.sku' | t }}</dt><dd>{{ current_variant.sku }}</dd>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endcapture -%}
            {%- if details_rows != blank -%}
              <div class="product__block product__details" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="product__label">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <dl class="details">{{ details_rows }}</dl>
              </div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            {%- capture collapsible_content -%}
              {{ block.settings.content }}
              {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              {%- if block.settings.show_policy_links -%}
                {%- if shop.shipping_policy != blank or shop.refund_policy != blank -%}
                  <ul class="policy-links">
                    {%- if shop.shipping_policy != blank -%}
                      <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
                    {%- endif -%}
                    {%- if shop.refund_policy != blank -%}
                      <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              {%- endif -%}
            {%- endcapture -%}
            {%- if collapsible_content != blank -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details>
                  <summary>{{ block.settings.heading }} {% render 'icon', icon: 'plus' %}{% render 'icon', icon: 'minus' %}</summary>
                  <div class="accordion__content rte">{{ collapsible_content }}</div>
                </details>
              </div>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="product__block rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  Mérettáblázat panel: a section-ön kívül, hogy a ragadós (sticky) jobb oszlop ne zárja be a rétegrendbe.
  A tartalmát a theme.js tölti be a mérettáblázat oldalról ([data-size-chart]) az első megnyitáskor.
{%- endcomment -%}
{%- if size_chart_shown -%}
  <div class="drawer drawer--right size-drawer" id="{{ size_chart_id }}" data-drawer aria-hidden="true">
    <button type="button" class="drawer__overlay" data-drawer-close tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
    <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ size_chart_label | escape }}">
      <div class="drawer__head">
        <span class="drawer__title">{{ size_chart_label }}</span>
        <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
      </div>
      <div class="drawer__body">
        <div class="size-chart" data-size-chart-content aria-live="polite">
          <p class="size-drawer__loading">{{ 'general.loading' | t }}</p>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Termék",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "large_first", "label": "Első kép nagyban", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Cím",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Felirat a cím fölött", "info": "Ha üres, a terméktípus jelenik meg." }
      ]
    },
    {
      "type": "price",
      "name": "Ár",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_tax_note", "label": "ÁFA megjegyzés megjelenítése", "default": false }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Változatválasztó",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "A méretek és színek a termék „Változatok” részéből jönnek (Termékek → termék → Változatok)." },
        {
          "type": "select",
          "id": "picker_style",
          "label": "Megjelenés",
          "options": [
            { "value": "list", "label": "Lista jelölőnégyzettel és készlettel" },
            { "value": "buttons", "label": "Gombok egy sorban" }
          ],
          "default": "list",
          "info": "A színmintás (swatch) opciók mindig kis színnégyzetként jelennek meg."
        },
        { "type": "checkbox", "id": "show_stock", "label": "Készletinformáció (Raktáron / Elfogyott)", "default": true },
        { "type": "range", "id": "low_stock", "label": "„Már csak X db” jelzés ennyi darab alatt", "min": 0, "max": 10, "step": 1, "default": 3, "info": "0 = kikapcsolva. Csak készletkövetéses termékeknél." },
        { "type": "page", "id": "size_chart_page", "label": "Mérettáblázat oldal", "info": "Ha üres, a „merettablazat” címkéjű (handle) oldal. A link a „Méret” / „Size” nevű opció mellett jelenik meg." },
        { "type": "text", "id": "size_chart_label", "label": "Mérettáblázat link szövege", "info": "Üresen hagyva a nyelvnek megfelelő alapszöveg jelenik meg (Mérettáblázat / Size chart)." }
      ]
    },
    {
      "type": "description",
      "name": "Leírás",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Megjelenés",
          "options": [
            { "value": "plain", "label": "Mindig látható szöveg" },
            { "value": "accordion", "label": "Lenyíló" }
          ],
          "default": "plain"
        },
        { "type": "text", "id": "heading", "label": "Cím", "default": "Leírás" },
        { "type": "checkbox", "id": "open", "label": "Lenyílóként alapból nyitva", "default": true }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Kosárba gomb",
      "limit": 1,
      "settings": [
        { "type": "product", "id": "pair_product", "label": "Szett párja", "info": "Pl. a pulóverhez a hozzá illő nadrág." },
        { "type": "text", "id": "pair_label", "label": "Szett gomb szövege", "info": "Üresen hagyva a nyelvnek megfelelő alapszöveg jelenik meg (Szettként / Complete the set)." }
      ]
    },
    {
      "type": "perks",
      "name": "Előnyök lista",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "lines", "label": "Sorok (soronként egy)", "default": "Ingyenes szállítás 30.000 Ft felett\n14 napos visszaküldés, kockázat nélkül" }
      ]
    },
    {
      "type": "details",
      "name": "Termék részletei",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Cím", "default": "Termék részletei" },
        { "type": "checkbox", "id": "show_category_metafields", "label": "Kategória adatai (Anyag, Szín, Nem, Ujjhossz stb.)", "info": "A termék szerkesztésénél a Kategória alatt megadott adatok. Csak a kitöltöttek jelennek meg.", "default": true },
        { "type": "checkbox", "id": "show_category", "label": "Termékkategória", "default": true },
        { "type": "checkbox", "id": "show_sku", "label": "Cikkszám (SKU)", "default": true },
        { "type": "checkbox", "id": "show_type", "label": "Terméktípus", "default": false },
        { "type": "checkbox", "id": "show_vendor", "label": "Márka (forgalmazó)", "default": false },
        { "type": "checkbox", "id": "show_weight", "label": "Súly", "default": false },
        { "type": "header", "content": "Saját sorok" },
        { "type": "paragraph", "content": "Az érték mező a szerkesztőben egy termék-metamezőhöz köthető (a mező melletti „Dinamikus forrás” ikonnal), így termékenként más-más érték jelenik meg." },
        { "type": "text", "id": "label_1", "label": "1. sor címe" },
        { "type": "text", "id": "value_1", "label": "1. sor értéke" },
        { "type": "text", "id": "label_2", "label": "2. sor címe" },
        { "type": "text", "id": "value_2", "label": "2. sor értéke" },
        { "type": "text", "id": "label_3", "label": "3. sor címe" },
        { "type": "text", "id": "value_3", "label": "3. sor értéke" },
        { "type": "text", "id": "label_4", "label": "4. sor címe" },
        { "type": "text", "id": "value_4", "label": "4. sor értéke" }
      ]
