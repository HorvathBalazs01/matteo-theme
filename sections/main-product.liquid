{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}

<section class="product page-width" data-product data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span aria-hidden="true">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="product__grid">
    <div class="product__gallery" data-gallery>
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          {%- liquid
            assign is_large = false
            if forloop.first and section.settings.large_first
              assign is_large = true
            endif
            assign loading = 'lazy'
            if forloop.index <= 2
              assign loading = 'eager'
            endif
            assign media_alt = media.alt | default: product.title | escape
          -%}
          <div class="product__media{% if is_large %} product__media--large{% endif %}" data-media-id="{{ media.id }}">
            {%- if media.media_type == 'image' -%}
              {{ media | image_url: width: 1800 | image_tag: loading: loading, widths: '500,750,1000,1400,1800', sizes: '(min-width: 990px) 33vw, 86vw', alt: media_alt }}
            {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
              {{ media | media_tag: image_size: '1400x', autoplay: true, loop: true, muted: true, controls: false }}
            {%- else -%}
              {{ media | media_tag }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="product__media product__media--large">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        <div class="product__media">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        <div class="product__media">{{ 'product-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {%- if block.settings.eyebrow != blank -%}
                <span class="product__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- elsif product.type != blank -%}
                <span class="product__eyebrow">{{ product.type }}</span>
              {%- endif -%}
              <h1 class="product__title display">{{ product.title }}</h1>
            </div>

          {%- when 'price' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              <div class="product__price" data-price>
                {% render 'price', product: product, use_variant: true %}
              </div>
              {%- if block.settings.show_tax_note -%}
                <span class="product__tax">{{ 'cart.taxes' | t }}</span>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              {%- liquid
                assign size_chart_page = block.settings.size_chart_page
                if size_chart_page == blank
                  assign size_chart_page = pages['merettablazat']
                endif
                assign size_chart_label = block.settings.size_chart_label
                if size_chart_label == blank
                  assign size_chart_label = 'products.size_chart' | t
                endif
                assign size_chart_id = 'size-chart-' | append: section.id
                assign size_chart_shown = false
              -%}
              {%- capture size_chart_link -%}
                <a href="{{ size_chart_page.url }}" class="option__size-link" data-drawer-open="{{ size_chart_id }}" data-size-chart-url="{{ size_chart_page.url }}" aria-controls="{{ size_chart_id }}" aria-expanded="false" aria-haspopup="dialog">{{ size_chart_label }}</a>
              {%- endcapture -%}
              <div class="product__block" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_index = forloop.index0
                    assign option_name = option.name | downcase
                    assign is_size_option = false
                    if option_name contains 'méret' or option_name contains 'meret' or option_name contains 'size'
                      assign is_size_option = true
                    endif
                  -%}
                  <fieldset class="option" data-option-index="{{ option_index }}">
                    <legend class="option__legend">
                      <div>{{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span></div>
                      {%- if is_size_option and size_chart_page != blank and size_chart_shown == false -%}
                        {{ size_chart_link }}
                        {%- assign size_chart_shown = true -%}
                      {%- endif -%}
                    </legend>
                    <div class="option__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                        <div class="option__value{% if value.swatch %} option__value--swatch{% endif %}{% unless value.available %} is-unavailable{% endunless %}">
                          <input
                            type="radio"
                            id="{{ input_id }}"
                            name="{{ section.id }}-option-{{ option.position }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            data-option-value
                          >
                          <label for="{{ input_id }}" {% if value.swatch %}title="{{ value | escape }}"{% endif %}>
                            {%- if value.swatch -%}
                              {%- if value.swatch.image -%}
                                {%- assign swatch_bg = value.swatch.image | image_url: width: 60 -%}
                                <span class="swatch" style="background: url({{ swatch_bg }}) center / cover;"></span>
                              {%- else -%}
                                <span class="swatch" style="background: {{ value.swatch.color }};"></span>
                              {%- endif -%}
                              <span class="visually-hidden">{{ value }}</span>
                            {%- else -%}
                              {{ value }}
                            {%- endif -%}
                          </label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                {%- if size_chart_page != blank and size_chart_shown == false -%}
                  {%- comment -%} Nincs „Méret” nevű opció: a link a választók alá kerül {%- endcomment -%}
                  <div class="option__size-fallback">{{ size_chart_link }}</div>
                  {%- assign size_chart_shown = true -%}
                {%- endif -%}
                <script type="application/json" data-variants>
                  {{ product.variants | json }}
                </script>
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="product__block" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product__form', novalidate: 'novalidate', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <div class="product__buttons" data-buy-buttons>
                  <button
                    type="submit"
                    name="add"
                    class="btn btn--solid btn--full"
                    data-add-button
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-label>
                      {%- if current_variant.available -%}
                        {{ 'products.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.pair_product != blank and block.settings.pair_product.id != product.id -%}
                    <a href="{{ block.settings.pair_product.url }}" class="btn btn--full">
                      {%- assign pair_label = block.settings.pair_label -%}
                      {%- if pair_label == blank -%}{%- assign pair_label = 'products.as_set' | t -%}{%- endif -%}
                      {{ pair_label }}: + {{ block.settings.pair_product.title }}
                    </a>
                  {%- endif -%}
                </div>
                <p class="product__error" role="alert" data-form-error></p>
              {%- endform -%}
            </div>

          {%- when 'perks' -%}
            {%- if block.settings.lines != blank -%}
              {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
              <ul class="perks" {{ block.shopify_attributes }}>
                {%- for line in lines -%}
                  {%- assign l = line | strip -%}
                  {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details {% if block.settings.open %}open{% endif %}>
                  <summary>{{ block.settings.heading }} {% render 'icon', icon: 'plus' %}{% render 'icon', icon: 'minus' %}</summary>
                  <div class="accordion__content rte">{{ product.description }}</div>
                </details>
              </div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <details>
                <summary>{{ block.settings.heading }} {% render 'icon', icon: 'plus' %}{% render 'icon', icon: 'minus' %}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                  {%- if block.settings.show_policy_links -%}
                    {%- if shop.shipping_policy != blank or shop.refund_policy != blank -%}
                      <ul class="policy-links">
                        {%- if shop.shipping_policy != blank -%}
                          <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
                        {%- endif -%}
                        {%- if shop.refund_policy != blank -%}
                          <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
                        {%- endif -%}
                      </ul>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </details>
            </div>

          {%- when 'text' -%}
            <div class="product__block rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  Mérettáblázat panel: a section-ön kívül, hogy a ragadós (sticky) jobb oszlop ne zárja be a rétegrendbe.
  A tartalmát a theme.js tölti be a mérettáblázat oldalról ([data-size-chart]) az első megnyitáskor.
{%- endcomment -%}
{%- if size_chart_shown -%}
  <div class="drawer drawer--right size-drawer" id="{{ size_chart_id }}" data-drawer aria-hidden="true">
    <button type="button" class="drawer__overlay" data-drawer-close tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
    <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ size_chart_label | escape }}">
      <div class="drawer__head">
        <span class="drawer__title">{{ size_chart_label }}</span>
        <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
      </div>
      <div class="drawer__body">
        <div class="size-chart" data-size-chart-content aria-live="polite">
          <p class="size-drawer__loading">{{ 'general.loading' | t }}</p>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Termék",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "large_first", "label": "Első kép nagyban", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Cím",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Felirat a cím fölött", "info": "Ha üres, a terméktípus jelenik meg." }
      ]
    },
    {
      "type": "price",
      "name": "Ár",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_tax_note", "label": "ÁFA megjegyzés megjelenítése", "default": false }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Változatválasztó",
      "limit": 1,
      "settings": [
        { "type": "page", "id": "size_chart_page", "label": "Mérettáblázat oldal", "info": "Ha üres, a „merettablazat” címkéjű (handle) oldal. A link a „Méret” / „Size” nevű opció mellett jelenik meg." },
        { "type": "text", "id": "size_chart_label", "label": "Mérettáblázat link szövege", "info": "Üresen hagyva a nyelvnek megfelelő alapszöveg jelenik meg (Mérettáblázat / Size chart)." }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Kosárba gomb",
      "limit": 1,
      "settings": [
        { "type": "product", "id": "pair_product", "label": "Szett párja", "info": "Pl. a pulóverhez a hozzá illő nadrág." },
        { "type": "text", "id": "pair_label", "label": "Szett gomb szövege", "info": "Üresen hagyva a nyelvnek megfelelő alapszöveg jelenik meg (Szettként / Complete the set)." }
      ]
    },
    {
      "type": "perks",
      "name": "Előnyök lista",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "lines", "label": "Sorok (soronként egy)", "default": "Ingyenes szállítás 30.000 Ft felett\n14 napos visszaküldés, kockázat nélkül" }
      ]
    },
    {
      "type": "description",
      "name": "Leírás",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Cím", "default": "Leírás" },
        { "type": "checkbox", "id": "open", "label": "Alapból nyitva", "default": true }
      ]
    },
    {
      "type": "collapsible",
      "name": "Lenyíló szöveg",
      "settings": [
        { "type": "text", "id": "heading", "label": "Cím", "default": "Anyag és ápolás" },
        { "type": "richtext", "id": "content", "label": "Szöveg" },
        { "type": "page", "id": "page", "label": "Vagy egy oldal tartalma" },
        { "type": "checkbox", "id": "show_policy_links", "label": "Szállítási és visszatérítési szabályzat linkje", "info": "Csak akkor jelenik meg, ha a szabályzat ki van töltve (Beállítások → Szabályzatok).", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Szöveg",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Szöveg" }
      ]
    }
  ]
}
{% endschema %}
