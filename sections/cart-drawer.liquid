<div class="drawer drawer--right cart-drawer" id="cart-drawer" data-drawer data-cart-drawer aria-hidden="true">
  <button type="button" class="drawer__overlay" data-drawer-close tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="drawer__head">
      <span class="drawer__title">{{ 'cart.title' | t }} ({{ cart.item_count }})</span>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__body">
        {% render 'shipping-bar' %}
        {%- for item in cart.items -%}
          {% render 'cart-item', item: item, index: forloop.index, context: 'drawer' %}
        {%- endfor -%}
      </div>
      <div class="drawer__foot">
        <div class="cart-row cart-row--total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-note">{{ 'cart.taxes' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--solid btn--full">{{ 'cart.checkout' | t }}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="link-underline" style="align-self: center;">{{ 'cart.view_cart' | t }}</a>
      </div>
    {%- else -%}
      <div class="drawer__body">
        <div class="empty-state">
          <p>{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'general.continue_shopping' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kosár panel",
  "settings": []
}
{% endschema %}
