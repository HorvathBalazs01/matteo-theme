<div class="cart-page page-width" data-cart-page data-section-id="{{ section.id }}">
  <h1 class="cart-page__title display">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cart-page__grid" novalidate>
      <div class="cart-page__items" data-cart-items>
        {%- for item in cart.items -%}
          {% render 'cart-item', item: item, index: forloop.index, context: 'page' %}
        {%- endfor -%}

        {%- if section.settings.show_note -%}
          <div style="margin-top: 32px; display: flex; flex-direction: column; gap: 12px; max-width: 480px;">
            <label for="cart-note" class="label">{{ 'cart.note' | t }}</label>
            <textarea id="cart-note" name="note" class="field">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <div class="cart-page__summary">
        {% render 'shipping-bar' %}
        <div class="cart-row cart-row--total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span data-cart-total>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-note">{{ 'cart.taxes' | t }}</p>
        <button type="submit" name="checkout" class="btn btn--solid btn--full">{{ 'cart.checkout' | t }}</button>
        <noscript><button type="submit" name="update" class="btn btn--full">{{ 'cart.update' | t }}</button></noscript>
        <a href="{{ routes.all_products_collection_url }}" class="link-underline" style="align-self: center;">{{ 'general.continue_shopping' | t }}</a>
      </div>
    </form>
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'general.continue_shopping' | t }} {% render 'icon', icon: 'arrow' %}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Kosár",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Megjegyzés mező", "default": true }
  ]
}
{% endschema %}
