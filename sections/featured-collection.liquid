{%- liquid
  assign featured = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="section page-width" style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="section-head">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ featured.url | default: routes.all_products_collection_url }}" class="link-underline">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="grid" style="--cols: {{ section.settings.columns }};">
    {%- if featured != blank and featured.products_count > 0 -%}
      {%- for product in featured.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        {% render 'product-card' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kiemelt termékek",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "heading", "label": "Cím", "default": "Legnépszerűbb termékeink" },
    { "type": "collection", "id": "collection", "label": "Kollekció" },
    { "type": "range", "id": "products_to_show", "label": "Termékek száma", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Oszlopok asztali nézetben", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link szövege", "default": "Összes termék" },
    { "type": "range", "id": "padding_top", "label": "Felső térköz", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Alsó térköz", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Kiemelt termékek" }]
}
{% endschema %}
