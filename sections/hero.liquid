{%- liquid
  assign slide_count = section.blocks.size
-%}
<section
  class="hero"
  data-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
  style="--hero-height: {{ section.settings.height }}px; --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --hero-logo-width: {{ section.settings.logo_width }}px;"
  aria-roledescription="carousel"
>
  <div class="hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign loading = 'lazy'
        assign heading_tag = 'h2'
        if forloop.first
          assign loading = 'eager'
          if section.index == 1 or section.index == 2
            assign heading_tag = 'h1'
          endif
        endif
      -%}
      <div
        class="hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ slide_count }}"
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign focal = block.settings.image.presentation.focal_point | default: 'center'
              assign img_style = 'object-position: ' | append: focal | append: ';'
            -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero__img', loading: loading, widths: '750,1100,1500,1800,2400', sizes: '100vw', alt: block.settings.image.alt, style: img_style }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="hero__overlay"></div>
        <div class="hero__content page-width{% if block.settings.align == 'center' %} hero__content--center{% endif %}">
          <div class="hero__content-inner">
            {%- if block.settings.show_logo -%}
              <div class="hero__logo">{% render 'logo', eager: forloop.first %}</div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <{{ heading_tag }} class="hero__heading display">{{ block.settings.heading | newline_to_br }}</{{ heading_tag }}>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn">
                {{ block.settings.button_label }}
                {% render 'icon', icon: 'arrow' %}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="hero__dot{% if forloop.first %} is-active{% endif %}"
          data-slide-to="{{ forloop.index0 }}"
          aria-label="{{ 'general.go_to_slide' | t: number: forloop.index }}"
          {% if forloop.first %}aria-current="true"{% endif %}
        >{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero (nagy kép)",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    { "type": "range", "id": "height", "label": "Magasság", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "overlay", "label": "Sötétítés a kép bal oldalán", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "logo_width", "label": "Logó szélessége", "min": 160, "max": 600, "step": 20, "unit": "px", "default": 400 },
    { "type": "checkbox", "id": "autoplay", "label": "Automatikus váltás", "default": true },
    { "type": "range", "id": "speed", "label": "Váltás ideje", "min": 3, "max": 12, "step": 1, "unit": "mp", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Dia",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Kép", "info": "Ajánlott: 2400 × 1400 px, sötét háttér. A fókuszpontot a képnél állíthatod be." },
        { "type": "checkbox", "id": "show_logo", "label": "Logó megjelenítése", "default": true },
        { "type": "textarea", "id": "heading", "label": "Szlogen", "default": "Minimalista stílus.\nMaximális hatás." },
        { "type": "text", "id": "button_label", "label": "Gomb szövege", "default": "Kollekció megtekintése" },
        { "type": "url", "id": "button_link", "label": "Gomb linkje" },
        {
          "type": "select",
          "id": "align",
          "label": "Szöveg igazítása",
          "options": [
            { "value": "left", "label": "Balra" },
            { "value": "center", "label": "Középre" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (nagy kép)",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
