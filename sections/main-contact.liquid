{%- comment -%}
  Kapcsolat oldal: elérhetőségek (blokkok) + kapcsolatfelvételi űrlap.
  Az űrlap üzenetei a bolt e-mail címére mennek (Beállítások → Áruház adatai).
  Használat: Online áruház → Oldalak → az oldal „Téma sablon”-ja: contact.
{%- endcomment -%}
<div class="page page--wide page-width">
  <h1 class="page__title display">{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="page__intro rte">{{ page.content }}</div>
  {%- endif -%}

  <div class="contact{% if section.blocks.size == 0 and section.settings.show_social == false %} contact--form-only{% endif %}">
    {%- if section.blocks.size > 0 or section.settings.show_social -%}
      <div class="contact__info">
        {%- for block in section.blocks -%}
          <div class="contact__item" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="contact__label">{{ block.settings.heading }}</h2>
            {%- endif -%}
            <div class="rte">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
        {%- if section.settings.show_social -%}
          {% render 'social-links', class: 'contact__social' %}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form-grid">
        <div class="form-field">
          <label for="ContactForm-name" class="form-label">{{ 'contact.name' | t }}</label>
          <input type="text" id="ContactForm-name" name="contact[{{ 'contact.name' | t }}]" class="field" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
        </div>
        <div class="form-field">
          <label for="ContactForm-email" class="form-label">{{ 'contact.email' | t }}</label>
          <input type="email" id="ContactForm-email" name="contact[email]" class="field" autocomplete="email" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
        </div>
        <div class="form-field">
          <label for="ContactForm-phone" class="form-label">{{ 'contact.phone' | t }} <span class="form-label__optional">{{ 'contact.optional' | t }}</span></label>
          <input type="tel" id="ContactForm-phone" name="contact[{{ 'contact.phone' | t }}]" class="field" autocomplete="tel" value="{{ form.phone }}">
        </div>
        <div class="form-field">
          <label for="ContactForm-order" class="form-label">{{ 'contact.order' | t }} <span class="form-label__optional">{{ 'contact.optional' | t }}</span></label>
          <input type="text" id="ContactForm-order" name="contact[{{ 'contact.order' | t }}]" class="field">
        </div>
        <div class="form-field form-field--full">
          <label for="ContactForm-body" class="form-label">{{ 'contact.message' | t }}</label>
          <textarea id="ContactForm-body" name="contact[body]" class="field" rows="7" required>{{ form.body }}</textarea>
        </div>
      </div>

      {%- if shop.privacy_policy != blank -%}
        <p class="form-note">{{ 'contact.privacy_html' | t: link: shop.privacy_policy.url }}</p>
      {%- endif -%}

      <button type="submit" class="btn btn--solid contact__submit">
        {{ 'contact.send' | t }}
        {% render 'icon', icon: 'arrow' %}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapcsolat",
  "class": "section-main-contact",
  "settings": [
    { "type": "paragraph", "content": "A bevezető szöveg az oldal saját tartalma (Online áruház → Oldalak). Az űrlap üzenetei a bolt e-mail címére érkeznek (Beállítások → Áruház adatai)." },
    { "type": "checkbox", "id": "show_social", "label": "Közösségi ikonok megjelenítése", "default": true }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Elérhetőség",
      "settings": [
        { "type": "text", "id": "heading", "label": "Cím", "default": "E-mail" },
        { "type": "richtext", "id": "text", "label": "Szöveg", "default": "<p>[EMAIL CÍM]</p>" }
      ]
    }
  ]
}
{% endschema %}
