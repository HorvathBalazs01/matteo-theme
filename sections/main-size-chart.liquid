{%- comment -%}
  Mérettáblázat oldal. A táblázatok soronként szerkeszthetők, az oszlopokat „|” választja el.
  Használat: Online áruház → Oldalak → az oldal „Téma sablon”-ja: size-chart, címkéje (handle): merettablazat.
  A termékoldal a [data-size-chart] tartalmát tölti be a becsúszó mérettáblázat panelbe.
{%- endcomment -%}
<div class="page page-width">
  <h1 class="page__title display">{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="page__intro rte">{{ page.content }}</div>
  {%- endif -%}

  <div class="size-chart" data-size-chart>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'table' -%}
          <div class="size-chart__block" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="size-chart__title section-title">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- liquid
              assign columns = block.settings.columns | split: '|'
              assign rows = block.settings.rows | newline_to_br | split: '<br />'
            -%}
            <div class="size-table__wrap">
              <table class="size-table">
                {%- if block.settings.heading != blank -%}
                  <caption class="visually-hidden">{{ block.settings.heading }}</caption>
                {%- endif -%}
                <thead>
                  <tr>
                    {%- for column in columns -%}
                      <th scope="col">{{ column | strip | escape }}</th>
                    {%- endfor -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for row in rows -%}
                    {%- assign row_text = row | strip -%}
                    {%- if row_text != blank -%}
                      {%- assign cells = row_text | split: '|' -%}
                      <tr>
                        {%- for cell in cells -%}
                          {%- if forloop.first -%}
                            <th scope="row">{{ cell | strip | escape }}</th>
                          {%- else -%}
                            <td>{{ cell | strip | escape }}</td>
                          {%- endif -%}
                        {%- endfor -%}
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            {%- if block.settings.note != blank -%}
              <p class="size-chart__note">{{ block.settings.note }}</p>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="size-chart__block" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="size-chart__title section-title">{{ block.settings.heading }}</h2>
            {%- endif -%}
            <div class="rte">{{ block.settings.text }}</div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Mérettáblázat",
  "class": "section-main-size-chart",
  "settings": [
    { "type": "paragraph", "content": "A bevezető szöveg az oldal saját tartalma (Online áruház → Oldalak). Ugyanez a táblázat jelenik meg a termékoldalon a „Mérettáblázat” linkre kattintva." }
  ],
  "blocks": [
    {
      "type": "table",
      "name": "Táblázat",
      "settings": [
        { "type": "text", "id": "heading", "label": "Cím", "default": "Felsők" },
        { "type": "text", "id": "columns", "label": "Oszlopok", "info": "Az oszlopneveket „|” jellel válaszd el.", "default": "Méret | Mellbőség (cm)" },
        { "type": "textarea", "id": "rows", "label": "Sorok", "info": "Soronként egy méret, az értékeket „|” jellel válaszd el. Pl.: M | 96–104", "default": "S | 88–96\nM | 96–104\nL | 104–112" },
        { "type": "text", "id": "note", "label": "Megjegyzés a táblázat alatt" }
      ]
    },
    {
      "type": "text",
      "name": "Szöveg",
      "settings": [
        { "type": "text", "id": "heading", "label": "Cím", "default": "Hogyan mérj?" },
        { "type": "richtext", "id": "text", "label": "Szöveg", "default": "<p>Szöveg</p>" }
      ]
    }
  ]
}
{% endschema %}
