<div class="not-found">
  <span class="not-found__code">404</span>
  <h1 class="display" style="font-size: 18px;">{{ 'not_found.title' | t }}</h1>
  <p style="color: var(--color-text-soft);">{{ 'not_found.text' | t }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'general.continue_shopping' | t }} {% render 'icon', icon: 'arrow' %}</a>
</div>

{% schema %}
{
  "name": "404 oldal",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
