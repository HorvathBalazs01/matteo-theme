{%- comment -%}
  GYIK oldal: csoportcímek + lenyíló kérdés-válasz blokkok, alul „Írj nekünk” gomb.
  Használat: Online áruház → Oldalak → az oldal „Téma sablon”-ja: faq.
  A kérdésekhez kapcsolódó link választható (mérettáblázat, kapcsolat, szabályzatok);
  ezek a megfelelő nyelvű oldalra mutatnak, és csak akkor jelennek meg, ha az oldal létezik.
{%- endcomment -%}
{%- liquid
  assign contact_page = section.settings.contact_page
  if contact_page == blank
    assign contact_page = pages['kapcsolat']
  endif
  assign size_page = pages['merettablazat']
-%}
<div class="page page-width">
  <h1 class="page__title display">{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="page__intro rte">{{ page.content }}</div>
  {%- endif -%}

  <div class="faq">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="faq__group section-title" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>

        {%- when 'question' -%}
          {%- liquid
            assign link_url = ''
            assign link_title = ''
            case block.settings.link
              when 'size_chart'
                if size_page != blank
                  assign link_url = size_page.url
                  assign link_title = size_page.title
                endif
              when 'contact'
                if contact_page != blank
                  assign link_url = contact_page.url
                  assign link_title = contact_page.title
                endif
              when 'refund_policy'
                if shop.refund_policy != blank
                  assign link_url = shop.refund_policy.url
                  assign link_title = shop.refund_policy.title
                endif
              when 'shipping_policy'
                if shop.shipping_policy != blank
                  assign link_url = shop.shipping_policy.url
                  assign link_title = shop.shipping_policy.title
                endif
              when 'terms_of_service'
                if shop.terms_of_service != blank
                  assign link_url = shop.terms_of_service.url
                  assign link_title = shop.terms_of_service.title
                endif
            endcase
          -%}
          <div class="accordion" {{ block.shopify_attributes }}>
            <details>
              <summary>{{ block.settings.question }} {% render 'icon', icon: 'plus' %}{% render 'icon', icon: 'minus' %}</summary>
              <div class="accordion__content">
                <div class="rte">{{ block.settings.answer }}</div>
                {%- if link_url != blank -%}
                  <a href="{{ link_url }}" class="faq__link link-underline">{{ link_title }} {% render 'icon', icon: 'arrow' %}</a>
                {%- endif -%}
              </div>
            </details>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_cta and contact_page != blank -%}
    <div class="faq__cta">
      <h2 class="faq__cta-title display">{{ 'faq.cta_heading' | t }}</h2>
      <p class="faq__cta-text">{{ 'faq.cta_text' | t }}</p>
      <a href="{{ contact_page.url }}" class="btn">{{ 'contact.write_us' | t }} {% render 'icon', icon: 'arrow' %}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "GYIK",
  "class": "section-main-faq",
  "settings": [
    { "type": "paragraph", "content": "A bevezető szöveg az oldal saját tartalma (Online áruház → Oldalak)." },
    { "type": "checkbox", "id": "show_cta", "label": "„Nem találod a választ?” doboz alul", "default": true },
    { "type": "page", "id": "contact_page", "label": "Kapcsolat oldal", "info": "Ha üres, a „kapcsolat” címkéjű (handle) oldal." }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Csoportcím",
      "settings": [
        { "type": "text", "id": "heading", "label": "Cím", "default": "Rendelés" }
      ]
    },
    {
      "type": "question",
      "name": "Kérdés",
      "settings": [
        { "type": "text", "id": "question", "label": "Kérdés", "default": "Kérdés" },
        { "type": "richtext", "id": "answer", "label": "Válasz", "default": "<p>Válasz</p>" },
        {
          "type": "select",
          "id": "link",
          "label": "Kapcsolódó link a válasz alatt",
          "options": [
            { "value": "none", "label": "Nincs" },
            { "value": "size_chart", "label": "Mérettáblázat" },
            { "value": "contact", "label": "Kapcsolat" },
            { "value": "refund_policy", "label": "Visszatérítési szabályzat" },
            { "value": "shipping_policy", "label": "Szállítási szabályzat" },
            { "value": "terms_of_service", "label": "Szolgáltatási feltételek (ÁSZF)" }
          ],
          "default": "none"
        }
      ]
    }
  ]
}
{% endschema %}
